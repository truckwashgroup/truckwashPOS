<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />

    <!--
      De map waar een gedownloade update belandt.

      Android geeft geen bestandspaden meer door tussen apps, dus krijgt de
      installer een adres via de FileProvider. Alleen paden die hier staan
      mogen zo doorgegeven worden; zonder deze regel weigert Android het met
      een uitzondering die niet uitlegt waarom.
    -->
    <external-files-path name="updates" path="updates/" />
</paths>