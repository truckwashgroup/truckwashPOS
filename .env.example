# Kopieer dit bestand naar .env en vul je eigen waarden in.
#
# Dit is HETZELFDE project als de wasstraat-app: de kassa en het dashboard
# praten met dezelfde database. Neem dus dezelfde twee waarden over als in
# het .env van de dashboard-repo.
#
# Vind je ze in Supabase onder: Project Settings -> API
#   VITE_SUPABASE_URL       = https://xxxx.supabase.co
#   VITE_SUPABASE_ANON_KEY  = de "anon public" / publishable sleutel
#
# De anon-key mag in de app staan: hij geeft alleen toegang tot wat de
# beveiligingsregels (RLS) toestaan. De "service_role" key hoort hier NOOIT
# in -- die omzeilt alle beveiliging. scripts/check-env.cjs laat de build
# mislukken als hij er toch een vindt.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
