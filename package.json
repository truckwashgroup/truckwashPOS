{
  "name": "truckwash-pos",
  "productName": "Truckwash1 Kassa",
  "version": "0.19.2",
  "description": "Truckwash1 Group - kassasysteem met klokin, werkt door zonder internet",
  "author": {
    "name": "Truckwash1 Group",
    "email": "casper@truckwash1group.nl"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-env.cjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "selftest": "tsx scripts/selftest.ts",
    "xmltest": "python scripts/xml-nakijken.py",
    "afdruk": "npm run build && node scripts/start-electron.cjs scripts/schermafdruk.cjs",
    "kern:check": "node scripts/kern-bijwerken.cjs",
    "kern:bijwerken": "node scripts/kern-bijwerken.cjs --schrijf",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && cross-env NODE_ENV=development node scripts/start-electron.cjs\"",
    "electron:start": "npm run build && node scripts/start-electron.cjs",
    "electron:build": "npm run build && electron-builder --win --config.win.signAndEditExecutable=false",
    "electron:publish": "npm run build && electron-builder --win --publish always",
    "cap:sync": "npm run build && node scripts/clean-native-assets.cjs && cap sync",
    "android:apk": "npm run cap:sync && node scripts/android-apk.cjs",
    "cap:android": "npm run cap:sync && cap open android",
    "assets:icons": "capacitor-assets generate --iconBackgroundColor '#0b1220' --iconBackgroundColorDark '#0b1220' --splashBackgroundColor '#0b1220' --splashBackgroundColorDark '#0b1220'",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@supabase/supabase-js": "^2.115.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^4.4.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.41.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/truckwashgroup/truckwashPOS.git"
  },
  "homepage": "https://github.com/truckwashgroup/truckwashPOS",
  "optionalDependencies": {
    "@img/sharp-win32-x64": "^0.35.4"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
